# .env mínimo para um servidor pequeno atendendo 1 a 5 empresas.
# Copie para .env.production na raiz do projeto e preencha os valores.
# Tudo que não está aqui usa o padrão de produção do compose.yaml.
#
# Gere segredos com:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Gere a chave Fernet: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Identidade da instalação -------------------------------------------
ENVIRONMENT=production
STRICT_RUNTIME_VALIDATION=true
LOG_JSON=true
# Domínio público com HTTPS. É usado nos links de e-mail, no redirect do
# Google e na URL do webhook que você cadastra na Meta.
WAPP_DOMAIN=app.suaempresa.com.br
PLATFORM_PUBLIC_URL=https://app.suaempresa.com.br
# Atrás do Caddy (deploy/compose.caddy.yaml) o IP real vem por cabeçalho.
TRUST_PROXY_HEADERS=true
# Só o Caddy fica exposto; os demais serviços escutam apenas em localhost.
APP_PORT=127.0.0.1:8000
POSTGRES_PORT=127.0.0.1:5432
ADMIN_PORT=127.0.0.1:8501

# --- Banco e cache (dentro do compose) -----------------------------------
POSTGRES_DB=project_wapp
POSTGRES_USER=project_wapp
POSTGRES_PASSWORD=troque-esta-senha
COMPOSE_DATABASE_URL=postgresql://project_wapp:troque-esta-senha@postgres:5432/project_wapp
COMPOSE_POSTGRES_DATABASE_URL=postgresql://project_wapp:troque-esta-senha@postgres:5432/project_wapp
COMPOSE_REDIS_URL=redis://redis:6379/0
REQUIRE_SHARED_STATE=true
RUN_MIGRATIONS_ON_STARTUP=false

# --- Segredos da aplicação ------------------------------------------------
ENABLE_ADMIN_AUTH=true
ADMIN_SUPERADMIN_TOKEN=
ADMIN_OPERATOR_TOKEN=
ADMIN_VIEWER_TOKEN=
PLATFORM_SESSION_SECRET=
PII_PSEUDONYMIZATION_KEY=
INTERNAL_INGRESS_SECRET=
CREDENTIALS_ENCRYPTION_KEY=
ENABLE_RATE_LIMITING=true

# --- Cadastro self-service e e-mail --------------------------------------
# Com cadastro aberto, o e-mail transacional (convites, senha) é obrigatório.
ENABLE_SELF_SERVICE_SIGNUP=true
TRANSACTIONAL_EMAIL_PROVIDER=resend
TRANSACTIONAL_EMAIL_FROM="Sua Marca <no-reply@suaempresa.com.br>"
RESEND_API_KEY=

# --- IA -------------------------------------------------------------------
# Para vender, use API (custo por conversa baixo, sem GPU). Ollama local fica
# como opção de privacidade; ver docs/local_qwen.md.
CLASSIFICATION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- WhatsApp (um app da Meta por instalação) -----------------------------
OUTBOUND_PROVIDER=whatsapp
INBOUND_WORKER_ENABLED=true
ENABLE_NORMALIZED_WHATSAPP_INGRESS=false
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v23.0
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Deixe vazios: com o Embedded Signup cada empresa conecta o próprio número
# pelo painel e recebe token próprio. Preencha só numa instalação antiga
# que tenha um único número configurado à mão.
WHATSAPP_API_BASE_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Agenda ---------------------------------------------------------------
# Agenda interna por padrão; cada empresa conecta o Google pelo painel.
CALENDAR_PROVIDER=mock
CALENDAR_TIMEZONE=America/Sao_Paulo
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=https://app.suaempresa.com.br/platform/integrations/google/callback

# --- Workers --------------------------------------------------------------
REMINDER_WORKER_ENABLED=true
AUTOMATION_ENGINE_ENABLED=false
AUTOMATION_WORKER_ENABLED=false

# --- Cobrança (deixe desligado até ter Stripe configurado) ---------------
ENABLE_BILLING_ENFORCEMENT=false
