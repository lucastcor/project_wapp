APP_NAME=Chatbot API
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
STRICT_RUNTIME_VALIDATION=true
ENABLE_RATE_LIMITING=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_ADMIN_REQUESTS=180
RATE_LIMIT_INCOMING_REQUESTS=120
RATE_LIMIT_WEBHOOK_REQUESTS=300
RATE_LIMIT_EXEMPT_LOCALHOST=false

OPENAI_API_KEY=
# Default único do produto. `app/core/config.py`, `.env.example` e `compose.yaml`
# precisam permanecer com o mesmo valor.
OPENAI_MODEL=gpt-4o-mini
OPENAI_FINETUNING_BASE_MODEL=gpt-4o-mini-2024-07-18
OPENAI_FINETUNING_SUFFIX=project-wapp-style
ENABLE_FINETUNING_PIPELINE=false
# Fallback global. A seleção por empresa vive em `company_models`.
OPENAI_FINETUNED_MODEL=
USE_FINETUNED_MODEL_FOR_REPLIES=false

# --- Identidade e autorização por tenant ---
# A ingestão exige credencial emitida por empresa (POST /admin/tenant-credentials).
ALLOW_UNAUTHENTICATED_INGEST=false
# Só o token legado de superadmin permanece global; viewer/operator legados
# ficam sem empresa até receberem membership explícita.
ALLOW_LEGACY_GLOBAL_ADMIN_TOKENS=false

# --- Pseudonimização (HMAC) ---
# Obrigatória em produção: sem ela, pseudônimos de telefone/documento são
# reversíveis por enumeração. Girar a chave invalida agrupamentos anteriores.
PII_PSEUDONYMIZATION_KEY=
PII_PSEUDONYMIZATION_KEY_VERSION=v1

# --- Contexto multi-turno e deduplicação ---
IMPORT_MAX_CONTEXT_TURNS=6
IMPORT_MAX_CONTEXT_CHARS=2000
# Distância de Hamming máxima entre SimHashes de 64 bits.
NEAR_DUPLICATE_MAX_DISTANCE=4

# --- Avaliação e promoção de modelo ---
# Avaliação model-backed executa o modelo real; CI nunca deve habilitar.
ENABLE_REAL_MODEL_EVALUATION=false
# Override emergencial do gate de promoção: exige superadmin e motivo.
ALLOW_PROMOTION_GATE_OVERRIDE=false

# --- Multiempresa: resolução de tenant e superfícies públicas ---
# Em produção o tenant vem do binding do canal, nunca do que o chamador envia.
ALLOW_UNTRUSTED_TENANT_HINTS=false
# Payload normalizado do webhook não tem assinatura do Meta.
ALLOW_NORMALIZED_WHATSAPP_WEBHOOK=false

# --- Estado compartilhado entre workers ---
# `memory` só serve para desenvolvimento e testes: rate limit e SSE ficam
# locais ao processo. Use `redis` quando houver mais de um worker.
SHARED_STATE_BACKEND=memory
REDIS_URL=

# --- Knowledge / RAG ---
KNOWLEDGE_RETRIEVAL_ENABLED=true
KNOWLEDGE_MAX_CHUNKS=6
KNOWLEDGE_MIN_SCORE=0.05
# `none` mantém a busca lexical determinística e sem chamada externa.
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_MODEL=text-embedding-3-small
ENABLE_VECTOR_SEARCH=false

# --- Importação de conversas ---
IMPORT_MAX_BYTES=5242880
IMPORT_MAX_MESSAGES_PER_BATCH=20000
IMPORT_SESSION_GAP_MINUTES=360

# --- Readiness de fine-tuning (bloqueia a criação do job) ---
FINETUNING_MIN_EXAMPLES=50
FINETUNING_MIN_SCENARIOS=3
FINETUNING_MIN_EXAMPLES_PER_SCENARIO=5
FINETUNING_MIN_EVAL_PASS_RATE=0.7

DATABASE_URL=postgresql://project_wapp:project_wapp@127.0.0.1:5432/project_wapp
POSTGRES_DATABASE_URL=postgresql://project_wapp:project_wapp@127.0.0.1:5432/project_wapp
COMPOSE_DATABASE_URL=postgresql://project_wapp:project_wapp@postgres:5432/project_wapp
COMPOSE_POSTGRES_DATABASE_URL=postgresql://project_wapp:project_wapp@postgres:5432/project_wapp
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
OPERATIONS_BACKUP_DIR=backups

ENABLE_ADMIN_AUTH=true
ADMIN_API_TOKEN=change-me-superadmin-token
ADMIN_VIEWER_TOKEN=change-me-viewer-token
ADMIN_OPERATOR_TOKEN=change-me-operator-token
ADMIN_SUPERADMIN_TOKEN=change-me-superadmin-token
PLATFORM_SESSION_SECRET=change-me-platform-session-secret
PLATFORM_SESSION_TTL_SECONDS=28800
ADMIN_ACTOR=streamlit-admin
ADMIN_APP_API_BASE_URL=http://127.0.0.1:8000
AUDIT_RETENTION_DAYS=90

REMINDER_WORKER_ENABLED=true
REMINDER_WORKER_POLL_SECONDS=60
REMINDER_WORKER_DISPATCH_IMMEDIATELY=true
REMINDER_WORKER_CHANNEL=
REMINDER_WORKER_AUDIENCES=customer,internal
APPOINTMENT_QUEUE_AUTO_DISPATCH=true
APPOINTMENT_QUEUE_RESPONSE_WINDOW_MINUTES=30
APPOINTMENT_QUEUE_WAIT_FOLLOWUP_MINUTES=30

CLASSIFICATION_PROVIDER=openai
OUTBOUND_PROVIDER=whatsapp
OUTBOUND_DEFAULT_CHANNEL=whatsapp

CALENDAR_PROVIDER=mock
CALENDAR_TIMEZONE=America/Sao_Paulo
CALENDAR_DEFAULT_WORKDAY_START=09:00
CALENDAR_DEFAULT_WORKDAY_END=18:00
CALENDAR_SLOT_INCREMENT_MINUTES=30
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
CALDAV_CALENDAR_NAME=

WHATSAPP_API_BASE_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me-whatsapp-verify-token
WHATSAPP_APP_SECRET=change-me-whatsapp-app-secret

POSTGRES_DB=project_wapp
POSTGRES_USER=project_wapp
POSTGRES_PASSWORD=project_wapp
POSTGRES_PORT=5432
APP_PORT=8000
ADMIN_PORT=8501

# --- Automation Studio ---
# Desligado por padrão nos dois planos. Nenhuma empresa passa a executar
# automação por causa de um deploy: ligar o motor é uma decisão, e cada fluxo
# ainda precisa ser ativado individualmente.
AUTOMATION_ENGINE_ENABLED=false
AUTOMATION_WORKER_ENABLED=false

# Teto de passos por execução. O validador já rejeita ciclos; este limite
# protege contra grafo grande e contra bug de avanço.
AUTOMATION_MAX_STEPS_PER_EXECUTION=50

# Tentativas antes do dead-letter, e o lease que impede dois workers de
# processarem o mesmo job.
AUTOMATION_MAX_ATTEMPTS=5
AUTOMATION_JOB_LEASE_SECONDS=60
AUTOMATION_GATE_LEASE_SECONDS=300

# Backoff exponencial com jitter limitado entre as tentativas.
AUTOMATION_RETRY_BASE_SECONDS=10
AUTOMATION_RETRY_MAX_SECONDS=3600

# Retenção de execuções e teto do payload de evento canônico.
AUTOMATION_EXECUTION_RETENTION_DAYS=90
AUTOMATION_MAX_EVENT_BYTES=16000

# Intervalo do loop do worker.
AUTOMATION_WORKER_POLL_SECONDS=2.0
