{
  "name": "wapp-automation-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Automation Studio do Project WAPP: editor visual de fluxos multi-tenant.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
