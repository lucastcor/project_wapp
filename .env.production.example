APP_NAME=Chatbot API
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_JSON=true
STRICT_RUNTIME_VALIDATION=true
ENABLE_RATE_LIMITING=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_ADMIN_REQUESTS=180
RATE_LIMIT_INCOMING_REQUESTS=120
RATE_LIMIT_WEBHOOK_REQUESTS=300
RATE_LIMIT_EXEMPT_LOCALHOST=false
# Enable only behind a trusted proxy that replaces forwarding headers.
TRUST_PROXY_HEADERS=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FINETUNING_BASE_MODEL=gpt-4o-mini-2024-07-18
OPENAI_FINETUNING_SUFFIX=project-wapp-style
ENABLE_FINETUNING_PIPELINE=false
OPENAI_FINETUNED_MODEL=
USE_FINETUNED_MODEL_FOR_REPLIES=false

DATABASE_URL=postgresql://project_wapp:project_wapp@127.0.0.1:5432/project_wapp
POSTGRES_DATABASE_URL=postgresql://project_wapp:project_wapp@127.0.0.1:5432/project_wapp
COMPOSE_DATABASE_URL=postgresql://project_wapp:project_wapp@postgres:5432/project_wapp
COMPOSE_POSTGRES_DATABASE_URL=postgresql://project_wapp:project_wapp@postgres:5432/project_wapp
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
RUN_MIGRATIONS_ON_STARTUP=false
REDIS_URL=redis://127.0.0.1:6379/0
COMPOSE_REDIS_URL=redis://redis:6379/0
REQUIRE_SHARED_STATE=true
REALTIME_REDIS_CHANNEL=project_wapp:realtime:v1
OPERATIONS_BACKUP_DIR=backups

ENABLE_ADMIN_AUTH=true
ADMIN_API_TOKEN=change-me-superadmin-token
ADMIN_VIEWER_TOKEN=change-me-viewer-token
ADMIN_OPERATOR_TOKEN=change-me-operator-token
ADMIN_SUPERADMIN_TOKEN=change-me-superadmin-token
# Optional tenant binding for platform sessions (comma-separated company ids).
# Empty means the role sees every company on the realtime stream.
ADMIN_VIEWER_COMPANY_IDS=
ADMIN_OPERATOR_COMPANY_IDS=
ADMIN_SUPERADMIN_COMPANY_IDS=
PLATFORM_SESSION_SECRET=change-me-platform-session-secret
PLATFORM_SESSION_TTL_SECONDS=28800
IDENTITY_SESSION_TTL_SECONDS=43200
IDENTITY_INVITATION_TTL_HOURS=72
IDENTITY_PASSWORD_RESET_TTL_MINUTES=30
ENABLE_SELF_SERVICE_SIGNUP=false
# Only enable this in development while wiring an email provider.
IDENTITY_EXPOSE_ACTION_TOKENS=false
PLATFORM_PUBLIC_URL=https://app.example.com
TRANSACTIONAL_EMAIL_PROVIDER=resend
TRANSACTIONAL_EMAIL_FROM=WAPP <no-reply@example.com>
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_TIMEOUT_SECONDS=10

# Stripe Billing. Use test-mode keys/prices in staging and live-mode values
# only in production. URLs must point to the public platform origin.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SUCCESS_URL=https://app.example.com/billing?checkout=success
STRIPE_CANCEL_URL=https://app.example.com/billing?checkout=cancelled
STRIPE_PORTAL_RETURN_URL=https://app.example.com/billing
STRIPE_PRICE_ESSENCIAL_MONTHLY=
STRIPE_PRICE_ESSENCIAL_ANNUAL=
STRIPE_PRICE_AVANCADO_MONTHLY=
STRIPE_PRICE_AVANCADO_ANNUAL=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ANNUAL=
BILLING_GRACE_PERIOD_DAYS=3
STRIPE_WEBHOOK_CLAIM_TTL_SECONDS=300
# Roll out only after every existing tenant has a reconciled subscription.
ENABLE_BILLING_ENFORCEMENT=false

# Internal (non-Meta) message ingress.
# ENABLE_NORMALIZED_WHATSAPP_INGRESS=true additionally requires a real
# INTERNAL_INGRESS_SECRET; without it the route fails closed with 503.
# INTERNAL_INGRESS_SECRET also authenticates POST /messages/incoming in production.
ENABLE_NORMALIZED_WHATSAPP_INGRESS=false
INTERNAL_INGRESS_SECRET=change-me-internal-ingress-secret
ADMIN_ACTOR=streamlit-admin
ADMIN_APP_API_BASE_URL=http://127.0.0.1:8000
AUDIT_RETENTION_DAYS=90

REMINDER_WORKER_ENABLED=true
REMINDER_WORKER_POLL_SECONDS=60
REMINDER_WORKER_BATCH_SIZE=100
REMINDER_WORKER_DISPATCH_IMMEDIATELY=true
REMINDER_WORKER_CHANNEL=
REMINDER_WORKER_AUDIENCES=customer,internal
APPOINTMENT_QUEUE_AUTO_DISPATCH=true
APPOINTMENT_QUEUE_RESPONSE_WINDOW_MINUTES=30
APPOINTMENT_QUEUE_WAIT_FOLLOWUP_MINUTES=30

CLASSIFICATION_PROVIDER=ollama
OUTBOUND_PROVIDER=whatsapp
OUTBOUND_DEFAULT_CHANNEL=whatsapp
OUTBOUND_MAX_ATTEMPTS=5
OUTBOUND_RETRY_BASE_SECONDS=30
OUTBOUND_RETRY_MAX_SECONDS=3600
OUTBOUND_CLAIM_TTL_SECONDS=300
WORKER_LEASE_TTL_SECONDS=300

CALENDAR_PROVIDER=mock
CALENDAR_TIMEZONE=America/Sao_Paulo
CALENDAR_DEFAULT_WORKDAY_START=09:00
CALENDAR_DEFAULT_WORKDAY_END=18:00
CALENDAR_SLOT_INCREMENT_MINUTES=30
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
CALDAV_CALENDAR_NAME=

WHATSAPP_API_BASE_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me-whatsapp-verify-token
WHATSAPP_APP_SECRET=change-me-whatsapp-app-secret

POSTGRES_DB=project_wapp
POSTGRES_USER=project_wapp
POSTGRES_PASSWORD=project_wapp
POSTGRES_PORT=5432
APP_PORT=8000
ADMIN_PORT=8501
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
LLM_TIMEOUT_SECONDS=30
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=512
OLLAMA_MAX_CONCURRENCY=1
INBOUND_WORKER_ENABLED=true
INBOUND_WORKER_POLL_SECONDS=1
INBOUND_JOB_LEASE_SECONDS=300
WORKER_HEARTBEAT_TTL_SECONDS=180
AUTOMATION_ENGINE_ENABLED=true
AUTOMATION_WORKER_ENABLED=true
PII_PSEUDONYMIZATION_KEY=change-me-pii-key
COMPOSE_OLLAMA_BASE_URL=http://host.docker.internal:11434
